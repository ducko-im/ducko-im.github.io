---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { WINDOW_SIZES } from '../../hero/data';
import { stateFor } from '../../hero/fixtures';
import type { HeroWindow } from '../../hero/types';
import { renderChatWindow } from '../../hero/view/chat';
import { renderContactsWindow } from '../../hero/view/contacts';
import { totalUnread } from '../../hero/view/shared';
import { tw } from '../../hero/view/tw';
import DockIcon from '../DockIcon.astro';

interface Props {
  id: string;
  window: HeroWindow | 'dock';
  description: string;
}

const { id, window, description } = Astro.props;
const DOCK_TILE = 128;
const state = stateFor(id);
const size = window === 'dock' ? { width: DOCK_TILE, height: DOCK_TILE } : WINDOW_SIZES[window];
const RENDERERS = { contacts: renderContactsWindow, chat: renderChatWindow };
const html = window === 'dock' ? null : RENDERERS[window](state);
const TOOLBAR_BUTTON = tw`rounded border border-neutral-400 px-2 py-1 aria-pressed:bg-neutral-800 aria-pressed:text-white`;
const APPEARANCES = [
  ['light', 'Light'],
  ['dark', 'Dark'],
];
const MODES = [
  ['side', 'Side by side'],
  ['overlay', 'Overlay'],
  ['difference', 'Difference'],
];

const capturesDir = resolve('reference/captures');
const captureJson = resolve(capturesDir, 'capture.json');
const displayScale: number | undefined = existsSync(captureJson) ? JSON.parse(readFileSync(captureJson, 'utf8')).displayScale : undefined;

// Captures are served from disk by Vite's /@fs/ route and never imported, so no capture can reach a build.
function capture(appearance: 'light' | 'dark') {
  const file = resolve(capturesDir, `${id}.${appearance}.png`);
  if (!existsSync(file)) return null;
  const header = readFileSync(file).subarray(16, 24);
  const pixelWidth = header.readUInt32BE(0);
  const pixelHeight = header.readUInt32BE(4);
  const scale = displayScale ?? (Math.round(pixelWidth / size.width) >= 2 ? 2 : 1);
  return { src: `/@fs${file}`, width: pixelWidth / scale, height: pixelHeight / scale };
}

const captures = { light: capture('light'), dark: capture('dark') };
---

<div class="flex min-h-svh flex-col gap-4 bg-neutral-200 p-6 font-mac text-sm text-neutral-800" data-lab data-captures={JSON.stringify(captures)}>
  <header class="flex flex-wrap items-center gap-3">
    <a href="/lab/" class="text-sky-700 underline">
      Lab
    </a>
    <h1 class="font-semibold">{id}</h1>
    <span class="text-neutral-500">{description}</span>
  </header>
  <div class="flex flex-wrap items-center gap-2" role="toolbar" aria-label="Comparison controls">
    {APPEARANCES.map(([appearance, label]) => (
      <button data-appearance-button={appearance} class={TOOLBAR_BUTTON}>
        {label}
      </button>
    ))}
    <span class="mx-2 h-5 w-px bg-neutral-400"></span>
    {MODES.map(([mode, label]) => (
      <button data-mode-button={mode} class={TOOLBAR_BUTTON}>
        {label}
      </button>
    ))}
    <label class="ml-2 flex items-center gap-2" data-opacity-control>
      Opacity <input type="range" min="0" max="100" value="50" data-opacity />
    </label>
  </div>
  <div class="flex items-start gap-8" data-stage>
    <div class="relative shrink-0" data-pair>
      <div data-appearance="light" data-web style={`width:${size.width}px;height:${size.height}px`}>
        {html === null ? <DockIcon size={DOCK_TILE} unread={totalUnread(state)} /> : <Fragment set:html={html} />}
      </div>
      <img data-capture alt="Reference capture" class="pointer-events-none absolute top-0 left-0" hidden />
    </div>
    <p data-missing class="text-neutral-500" hidden>
      No reference captured yet
    </p>
  </div>
</div>

<script>
  type Capture = { src: string; width: number; height: number } | null;

  const lab = document.querySelector<HTMLElement>('[data-lab]')!;
  const captures = JSON.parse(lab.dataset.captures!) as Record<'light' | 'dark', Capture>;
  const web = lab.querySelector<HTMLElement>('[data-web]')!;
  const pair = lab.querySelector<HTMLElement>('[data-pair]')!;
  const stage = lab.querySelector<HTMLElement>('[data-stage]')!;
  const image = lab.querySelector<HTMLImageElement>('[data-capture]')!;
  const missing = lab.querySelector<HTMLElement>('[data-missing]')!;
  const opacity = lab.querySelector<HTMLInputElement>('[data-opacity]')!;
  const opacityControl = lab.querySelector<HTMLElement>('[data-opacity-control]')!;

  const params = new URLSearchParams(location.search);
  let appearance: 'light' | 'dark' = params.get('appearance') === 'dark' ? 'dark' : 'light';
  let mode = params.get('mode') ?? 'side';

  function render() {
    web.dataset.appearance = appearance;
    const capture = captures[appearance];
    missing.hidden = capture !== null;
    image.hidden = capture === null;
    if (capture) {
      image.src = capture.src;
      image.style.width = `${capture.width}px`;
      image.style.height = `${capture.height}px`;
    }
    const stacked = mode !== 'side';
    (stacked ? pair : stage).append(image);
    image.classList.toggle('absolute', stacked);
    image.style.mixBlendMode = mode === 'difference' ? 'difference' : '';
    image.style.opacity = mode === 'overlay' ? String(Number(opacity.value) / 100) : '1';
    opacityControl.hidden = mode !== 'overlay';
    lab
      .querySelectorAll<HTMLElement>('[data-appearance-button]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.appearanceButton === appearance)));
    lab.querySelectorAll<HTMLElement>('[data-mode-button]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeButton === mode)));
    const url = new URL(location.href);
    url.searchParams.set('appearance', appearance);
    url.searchParams.set('mode', mode);
    history.replaceState(null, '', url);
  }

  lab.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-appearance-button], [data-mode-button]');
    if (!button) return;
    if (button.dataset.appearanceButton) appearance = button.dataset.appearanceButton as 'light' | 'dark';
    if (button.dataset.modeButton) mode = button.dataset.modeButton;
    render();
  });
  opacity.addEventListener('input', render);
  render();
</script>
