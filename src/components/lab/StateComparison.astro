---
import { tw } from '../../hero/view/tw';
import LabCapture from './LabCapture.astro';
import LabWeb from './LabWeb.astro';
import { type Appearance, type LabWindow, labCase, loadCaptures } from './lab';

interface Props {
  id: string;
  window: LabWindow;
  description: string;
}

const { id, window, description } = Astro.props;
const captures = loadCaptures();
const TOOLBAR_BUTTON = tw`rounded border border-neutral-400 px-2 py-1 aria-pressed:bg-neutral-800 aria-pressed:text-white`;
const APPEARANCES: [Appearance, string][] = [
  ['light', 'Light'],
  ['dark', 'Dark'],
];
const MODES = [
  ['side', 'Side by side'],
  ['overlay', 'Overlay'],
  ['difference', 'Difference'],
];
const pairs = APPEARANCES.map(([appearance]) => ({ appearance, ...labCase(captures, id, window, appearance) }));
---

<div class="flex min-h-svh flex-col gap-4 bg-neutral-200 p-6 font-mac text-sm text-neutral-800" data-lab>
  <header class="flex flex-wrap items-center gap-3">
    <a href="/lab/" class="text-sky-700 underline">
      Lab
    </a>
    <h1 class="font-semibold">{id}</h1>
    <span class="text-neutral-500">{description}</span>
  </header>
  <div class="flex flex-wrap items-center gap-2" role="toolbar" aria-label="Comparison controls">
    {APPEARANCES.map(([appearance, label]) => (
      <button data-appearance-button={appearance} class={TOOLBAR_BUTTON}>
        {label}
      </button>
    ))}
    <span class="mx-2 h-5 w-px bg-neutral-400"></span>
    {MODES.map(([mode, label]) => (
      <button data-mode-button={mode} class={TOOLBAR_BUTTON}>
        {label}
      </button>
    ))}
    <label class="ml-2 flex items-center gap-2" data-opacity-control>
      Opacity <input type="range" min="0" max="100" value="50" data-opacity />
    </label>
  </div>
  {pairs.map(({ appearance, capture, layout, built }) => (
    <div class="relative flex items-start gap-8 self-start" data-pair={appearance} hidden>
      <LabWeb {window} {appearance} {layout} {built} />
      {capture ? <LabCapture {capture} {layout} /> : <p class="text-neutral-500">No reference captured yet</p>}
    </div>
  ))}
</div>

<script>
  import { settleChatWindows } from '../../hero/placement';

  const lab = document.querySelector<HTMLElement>('[data-lab]')!;
  const opacity = lab.querySelector<HTMLInputElement>('[data-opacity]')!;
  const opacityControl = lab.querySelector<HTMLElement>('[data-opacity-control]')!;

  const params = new URLSearchParams(location.search);
  let appearance = params.get('appearance') === 'dark' ? 'dark' : 'light';
  let mode = params.get('mode') ?? 'side';

  function render() {
    const stacked = mode !== 'side';
    for (const pair of lab.querySelectorAll<HTMLElement>('[data-pair]')) {
      pair.hidden = pair.dataset.pair !== appearance;
      const capture = pair.querySelector<HTMLElement>('[data-capture]');
      if (!capture) continue;
      capture.classList.toggle('absolute', stacked);
      capture.classList.toggle('top-0', stacked);
      capture.classList.toggle('left-0', stacked);
      capture.style.mixBlendMode = mode === 'difference' ? 'difference' : '';
      capture.style.opacity = mode === 'overlay' ? String(Number(opacity.value) / 100) : '1';
    }
    settleChatWindows(lab.querySelector(`[data-pair="${appearance}"]`)!);
    opacityControl.hidden = mode !== 'overlay';
    lab
      .querySelectorAll<HTMLElement>('[data-appearance-button]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.appearanceButton === appearance)));
    lab.querySelectorAll<HTMLElement>('[data-mode-button]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.modeButton === mode)));
    const url = new URL(location.href);
    url.searchParams.set('appearance', appearance);
    url.searchParams.set('mode', mode);
    history.replaceState(null, '', url);
  }

  lab.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLElement>('[data-appearance-button], [data-mode-button]');
    if (!button) return;
    if (button.dataset.appearanceButton) appearance = button.dataset.appearanceButton;
    if (button.dataset.modeButton) mode = button.dataset.modeButton;
    render();
  });
  opacity.addEventListener('input', render);
  render();
</script>
