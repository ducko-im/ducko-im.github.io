---
import AppIcon from './AppIcon.astro';

// The app icon as it sits in the Dock, with its unread badge. `--dock-icon` is the icon artwork's size, not the Dock
// tile's: macOS draws the artwork at 824/1024 of the tile. The badge is sized from it, so it keeps the captured
// proportions at every icon size.
interface Props {
  unread: number;
  size?: number;
  sizes?: string;
}

const { unread, size, sizes } = Astro.props;
---

<span class="relative block size-(--dock-icon)" style={size ? `--dock-icon:${size}px` : undefined}>
  <AppIcon size={size ?? 96} {sizes} class="size-full drop-shadow-[0_12px_24px_rgb(0_0_0/0.25)]" />
  <span
    data-dock-badge
    aria-hidden="true"
    class="absolute -top-[calc(var(--dock-icon)*0.125)] -right-[calc(var(--dock-icon)*0.115)] grid h-[calc(var(--dock-icon)*0.485)] min-w-[calc(var(--dock-icon)*0.485)] place-items-center rounded-full bg-[#f03c32] px-[calc(var(--dock-icon)*0.1)] font-mac text-[calc(var(--dock-icon)*0.25)] leading-none text-white"
    hidden={unread === 0}
  >
    {unread}
  </span>
</span>
