---
import type { GetStaticPaths } from 'astro';
import manifest from '../../../reference/states.json';
import LabOverview from '../../components/lab/LabOverview.astro';
import OgCard from '../../components/lab/OgCard.astro';
import StateComparison from '../../components/lab/StateComparison.astro';
import type { LabWindow } from '../../components/lab/lab';
import { iconMasks } from '../../hero/view/icons';
import BaseLayout from '../../layouts/BaseLayout.astro';

// The lab is a development tool: production builds get no paths, so no lab page ships.
export const getStaticPaths = (() => {
  if (!import.meta.env.DEV) return [];
  return [{ params: { slug: undefined } }, { params: { slug: 'og' } }, ...manifest.states.map((state) => ({ params: { slug: state.id } }))];
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const state = manifest.states.find((s) => s.id === slug);
---

<BaseLayout title={slug ? `Lab: ${slug}` : 'Lab'} noindex bodyClass="bg-neutral-200">
  <Fragment set:html={iconMasks} />
  {slug === 'og' && <OgCard />}
  {state && <StateComparison id={state.id} window={state.window as LabWindow} description={state.description} />}
  {slug === undefined && <LabOverview />}
</BaseLayout>

<style is:global>
  /* Astro's dev toolbar would land in lab screenshots. */
  astro-dev-toolbar {
    display: none;
  }
</style>
